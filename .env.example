# AI Provider: "anthropic" (default), "gemini", or "qwen"
NIGHTWATCH_PROVIDER=anthropic

# API Keys (set the key for your chosen NIGHTWATCH_PROVIDER):
# Anthropic:
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio key):
GEMINI_API_KEY=
# Qwen (Alibaba Cloud Model Studio International — explicit fallback):
# Singapore region (ap-southeast-1) grants new accounts ~1M free tokens/model.
# Enable "Use Free Quota Only" in Model Studio console to block paid overage!
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional: model overrides (defaults are automatically chosen per provider)
# anthropic defaults: MODEL=claude-sonnet-5-5, DEEP_MODEL=claude-sonnet-5-5
# gemini defaults:    MODEL=gemini-3.5-flash,  DEEP_MODEL=gemini-3.5-flash
# qwen defaults:      MODEL=qwen-plus,         DEEP_MODEL=qwen-max
NIGHTWATCH_MODEL=
NIGHTWATCH_DEEP_MODEL=

# Global daily AI request budget (tracked in SQLite across all provider calls; default 15)
NIGHTWATCH_AI_DAILY_BUDGET=15
# Optional: raises GitHub API rate limit (60/h -> 5000/h) and allows private repos you own
GITHUB_TOKEN=
# Optional: Etherscan V2 key (Base = chainId 8453) used as a source fallback
ETHERSCAN_API_KEY=
# Optional: custom Base RPC (defaults to https://mainnet.base.org)
BASE_RPC_URL=
# EAS schema UID on Base for NightWatch attestations (run `npm run register-schema`)
NEXT_PUBLIC_EAS_SCHEMA_UID=
# Only for `npm run register-schema`: funded deployer key on Base
DEPLOYER_PRIVATE_KEY=

# One-click fix PRs (GitHub OAuth App; callback URL = <your-origin>/api/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# random string >= 32 chars; encrypts the GitHub session cookie
SESSION_SECRET=

# Night Shift watch mode
# Self-hosted: set to 1 to run the in-process worker (checks due watches every minute)
NIGHTWATCH_WORKER=
# Serverless: call POST /api/watch/tick from a cron with `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Pay-per-audit (testnet USDC on Base Sepolia; the server never holds a key, it only reads the chain)
# Address that receives payments. Leave empty to disable paid tiers.
NIGHTWATCH_TREASURY=
NIGHTWATCH_PRICE_PRIORITY_USDC=1
NIGHTWATCH_PRICE_DEEP_USDC=5
# Optional: Base Sepolia RPC (default https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=
# Queue: audits running at once, and how much of a head start paid jobs get over free ones
NIGHTWATCH_CONCURRENCY=2
NIGHTWATCH_PRIORITY_HEAD_START_SEC=600
# Optional: model for the deep swarm (defaults to NIGHTWATCH_MODEL)
NIGHTWATCH_DEEP_MODEL=
